{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "app": {
    "windows": [
      {
        "title": "VeloTerm",
        "width": 960,
        "height": 640,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "externalBin": ["binaries/coreutils"],
    "resources": {
      "binaries/veloterm_goffi.dll": "lib/veloterm_goffi.dll",
      "binaries/qalcffi.dll": "lib/qalcffi.dll",
      "binaries/nmapffi.dll": "lib/nmapffi.dll",
      "binaries/ncatffi.dll": "lib/ncatffi.dll",
      "binaries/npingffi.dll": "lib/npingffi.dll",
      "binaries/nmap-data": "nmap-data",
      "binaries/ca-bundle.crt": "ca-bundle.crt",
      "binaries/vim64.dll": "lib/vim64.dll",
      "binaries/vim-runtime": "vim-runtime",
      "binaries/pdfium": "pdfium"
    },
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
