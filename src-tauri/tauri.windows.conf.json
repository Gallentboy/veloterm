{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "app": {
    "windows": [
      {
        "title": "VeloTerm",
        "width": 960,
        "height": 640,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "externalBin": ["binaries/coreutils"],
    "resources": {
      "binaries/veloterm_goffi.dll": "lib/veloterm_goffi.dll",
      "binaries/qalcffi.dll": "lib/qalcffi.dll",
      "binaries/nmapffi.dll": "lib/nmapffi.dll",
      "binaries/nmap-data": "nmap-data"
    },
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
