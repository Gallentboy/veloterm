# Local
.DS_Store
*.local
*.log*

# Type check
*.tsbuildinfo

# Dist
node_modules
dist/
# 例外：vim runtime 的 autoload/dist/ 是 filetype 检测的必需源码目录
#（上游 9.1 起 filetype.vim/scripts.vim 走 dist#ft#*/dist#script#* autoload
# 函数），首次 vendor 即被上面的 dist/ 规则静默忽略、装机后 vim 开文件
# 必弹 E117——勿删本否定规则（详见 vendor/vim/README.md 的实踩登记）
!src-tauri/vendor/vim/runtime/autoload/dist/

# Profile
.rspack-profile-*/

# IDE
.vscode/*
!.vscode/extensions.json
.idea
# AI coding 工具目录（自动添加）
.zcode/
.agents/
.claude/
.workbuddy/
.workbuddy-ai/
.cursor/
.kilo/
.codex/
.aider/
.continue/
.windsurf/
.copilot/
.zed/
.gemini/
.droid/
.factory/
.goose/
.roo/
.cline/
.trae/
.worktrees/
binaries/
# vendor 仓库本地构建产物（源码进库，target 不进）
src-tauri/vendor/*/target/
# vcpkg manifest 模式安装产物（CI 用，二进制缓存走 GitHub Packages feed）
src-tauri/vcpkg_installed/
# qalc（libqalculate）的 MSYS2 autotools VPATH 构建目录（build-tools.mjs 产出）
src-tauri/qalc-build/
# nmap 的 MSVC+CMake 构建目录（build-tools.mjs 产出：CMake 出 x64 DLL +
# Npcap SDK/staging）
src-tauri/nmap-build/
# vim 的官方 VIMDLL 构建目录（build-tools.mjs 产出：src 副本内 nmake in-tree 构建）
src-tauri/vim-build/
# 本地第三方源码目录（如 warpgate）：内容不进库；曾被 git add 误记为无 .gitmodules
# 的 gitlink（幽灵 submodule），actions/checkout 清理时报 fatal: No url found
thirdpart/
